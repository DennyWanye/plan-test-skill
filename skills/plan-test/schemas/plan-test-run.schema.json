{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-test-run.schema.json",
  "title": "plan-test verification run ledger",
  "description": "唯一状态账本（schema 1.5.0）。只存原始 fact/event；所有 status/state/projection 由 plan_test_gate.py 在检查时完全重算。1.5.0 新增：分层 challenge 编排、testcase 编译清单、evidence contract、结构化 audit finding 与可选 active-run 身份。版本策略：validator 校验 major 相同；1.x 旧 minor 可读，新增严格能力均为显式启用。",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_request",
    "scenarios",
    "runs",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "repo_root": {
      "type": "string"
    },
    "fixture_only": {
      "type": "boolean",
      "description": "true = 测试 fixture，跳过 git HEAD 校验；receipt/report 永远标注 FIXTURE-ONLY，不可作为真实交付证据"
    },
    "active_run_required": {
      "type": "boolean",
      "description": "true 时必须显式 activate-run，且 active-run registry 必须持续匹配当前 run 和候选内容身份"
    },
    "structured_audit_required": {
      "type": "boolean",
      "description": "true 时 audit 只接受含 findings 数组的 JSON envelope；compiled 1.5 workflow 自动启用"
    },
    "compiled_manifest": {
      "type": ["object", "null"],
      "description": "compile-manifest 生成并由 init 冻结的验证表面、输入哈希与 testcase 选择"
    },
    "revision": {
      "type": "integer",
      "description": "CAS 并发控制版本号，每次写 +1"
    },
    "source_request": {
      "type": "object",
      "description": "冻结的原始用户请求（不可被派生文档替代）",
      "properties": {
        "path": {
          "type": "string"
        },
        "inline": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "behavior_contract": {
      "type": "object",
      "description": "术语表 + before/after 行为表 + 保留/删除/改变清单 + 用户批准事件",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "before_after": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "type": "object",
          "properties": {
            "user_message_sha256": {
              "type": "string"
            },
            "approved_at": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    },
    "behavior_changes": {
      "type": "array",
      "description": "行为变更授权：修改/删除/反转 frozen oracle 的唯一合法通道",
      "items": {
        "type": "object",
        "required": [
          "behavior_change_id"
        ],
        "properties": {
          "behavior_change_id": {
            "type": "string"
          },
          "old_behavior": {
            "type": "string"
          },
          "new_behavior": {
            "type": "string"
          },
          "approval": {
            "type": "object",
            "required": [
              "user_message_sha256"
            ],
            "properties": {
              "user_message_sha256": {
                "type": "string"
              },
              "acceptance_revision": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "expiry": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "testcase_lock": {
      "type": "object",
      "description": "实现前冻结的 black-box oracle；任何 byte 变化默认 FROZEN_ORACLE_CHANGED",
      "properties": {
        "locked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "abs_path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "behavior_change_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "init 时从冻结输入自动创建；validator 重算状态，初始即 NOT_RUN",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "required"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "gate_type": {
            "enum": [
              "positive-value",
              "negative-safety",
              "regression",
              "exploratory"
            ]
          },
          "ui": {
            "type": "boolean"
          },
          "expected_run_created": {
            "type": "boolean"
          },
          "required_lanes": {
            "type": "array",
            "items": {
              "enum": [
                "fresh",
                "history-upgrade",
                "temporal-fault",
                "exploratory"
              ]
            }
          },
          "min_root_runs": {
            "type": "integer",
            "minimum": 1
          },
          "ac_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testcase_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "由 compile-manifest 绑定到该场景的 testcase 资产 ID"
          },
          "evidence_contract": {
            "type": "object",
            "description": "显式证据契约；缺省时保持 1.4 兼容语义",
            "properties": {
              "producer_types": {"type": "array", "items": {"type": "string"}},
              "required_artifact_kinds": {"type": "array", "items": {"type": "string"}},
              "required_identity": {"type": "array", "items": {"type": "string"}},
              "required_timestamps": {"type": "boolean"},
              "required_business_facts": {"type": "array", "items": {"type": "string"}}
            }
          },
          "input_class": {
            "type": "string",
            "description": "语义不等价的输入类别标签。input_sensitive=true 时 required 场景须覆盖 ≥min_distinct_input_classes 个不同值（重试/重放/同意图改写不算新类别）"
          },
          "impact_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "本场景关联的代码路径 glob（如 backend/**）。behavioral 变更只 stale 命中的场景；fail-closed：任一变更未被任何场景的映射覆盖、清单被截断、或场景未声明映射 → 按全量复测。init 冻结，事后改映射即 LEDGER_TAMPERED"
          },
          "cold_start": {
            "type": "boolean",
            "description": "是否为冷路径场景（全新安装/清数据 → 首次登录 → 直达功能页）。stateful_init=true 时矩阵必须含一条"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "description": "原始执行 fact。retry/replay/continuation 不计 distinct，只有 root 计入场景状态",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "kind",
          "result"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "root",
              "retry",
              "continuation",
              "replay"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "partial",
              "blocked",
              "not_run"
            ]
          },
          "lane": {
            "enum": [
              "fresh",
              "history-upgrade",
              "temporal-fault",
              "exploratory"
            ]
          },
          "driver": {
            "enum": [
              "ai",
              "human"
            ]
          },
          "command": {
            "type": "string"
          },
          "engine_terminal": {
            "type": "string"
          },
          "business_terminal": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "run_id_under_test": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "primary（截图/日志/命令回执/DB 记录）才能作证；derived（汇总报告）只辅助审计。depends_on 构成依赖图，validator 拒绝环",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "相对 run-dir"
          },
          "sha256": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "primary",
              "derived"
            ]
          },
          "scenario_id": {
            "type": "string"
          },
          "ui_action": {
            "type": "boolean"
          },
          "negative_assertion": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_mtime": {
            "type": "string",
            "description": "attach 时刻的证据文件 mtime（RFC3339 UTC）。早于 created_at 超过宽限且未标 imported → EVIDENCE_PREDATES_LEDGER（先测后开账）"
          },
          "imported": {
            "type": "boolean",
            "description": "true = 经 import-evidence 显式导入的历史证据（开账之前产生），豁免 EVIDENCE_PREDATES_LEDGER"
          },
          "imported_from": {
            "type": "string",
            "description": "历史证据的来源说明（原始 run 目录/会话/采集时间）——chain of custody"
          },
          "producer_type": {"type": "string"},
          "producer_version": {"type": "string"},
          "artifact_kind": {"type": "string"},
          "generated_at": {"type": "string"},
          "root_run_id": {"type": "string"},
          "session_id": {"type": "string"},
          "business_facts": {"type": "object"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "description": "用户在 chat 中的显式批准记录（record-approval 写入）。每条绑定批准消息原文的 SHA-256，事后可对质。当前用途：all-ai-driving（输入语义敏感 + required UI 场景全 AI 驾驶时必须有）、scope-reduction",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "message_sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "all-ai-driving",
              "scope-reduction"
            ]
          },
          "approved_by": {
            "const": "user"
          },
          "message_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "declared_statuses": {
      "type": "array",
      "description": "各文档（README/testcase 头/RESULTS/Gate 报告）口头声明的状态，仅用于对账；与重算结果冲突 → STATUS_CONFLICT",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "description": "手写交付结论登记处；与账本冲突 → DELIVERY_VERDICT_CONTRADICTS_LEDGER",
      "properties": {
        "verdict": {
          "type": "string"
        }
      }
    },
    "auditor": {
      "type": "object",
      "description": "独立 full-audit 结果；facts_digest 冻结审计时的账本，此后任何 fact 变化 → AUDITOR_INPUT_STALE",
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "engine": {
          "type": "string"
        },
        "input_path": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "output_sha256": {
          "type": "string"
        },
        "facts_digest": {
          "type": "string"
        }
      }
    },
    "audit_findings": {
      "type": "array",
      "description": "当前结构化审计义务；open/deferred P0/P1 阻断 finalize",
      "items": {"$ref": "#/$defs/auditFinding"}
    },
    "audit_findings_history": {
      "type": "array",
      "description": "被后续审计替代的 finding 快照"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string"
        },
        "dirty_patch_sha256": {
          "type": "string"
        }
      }
    },
    "runtime_attestation": {
      "type": "object",
      "description": "被测运行物身份（project adapter 输出）；adapter_status=UNKNOWN 时真实 E2E 只能 BLOCKED",
      "properties": {
        "head": {
          "type": "string"
        },
        "dirty_patch_sha256": {
          "type": "string"
        },
        "adapter_status": {
          "enum": [
            "OK",
            "UNKNOWN"
          ]
        },
        "components": {
          "type": "array"
        },
        "user_data_mode": {
          "enum": [
            "fresh",
            "history-upgrade"
          ]
        }
      }
    },
    "release_unit": {
      "type": "object",
      "description": "交付体量指标；超 thresholds → RELEASE_UNIT_TOO_LARGE",
      "properties": {
        "must_ac_count": {
          "type": "integer"
        },
        "task_count": {
          "type": "integer"
        },
        "plan_lines": {
          "type": "integer"
        },
        "high_risk_subsystems": {
          "type": "integer"
        },
        "concurrent_layer_kinds": {
          "type": "integer"
        }
      }
    },
    "thresholds": {
      "type": "object"
    },
    "timing": {
      "type": "array",
      "description": "时间成本一等证据（schema 1.1.0 起，plan 2026-07-27-plan-test-gate-slice-1a §2）。measured=true 的起止/时长由 CLI --exec 包裹执行实测（wall clock RFC 3339 UTC + monotonic elapsed_ms），调用者不可覆写；measured=false 为申报值（真人 E2E 等外部活动），report 单列曝光、不计入实测聚合。聚合值由 render 重算，不落盘",
      "items": {
        "type": "object",
        "required": [
          "timing_id",
          "activity_class",
          "started_at",
          "ended_at",
          "elapsed_ms",
          "measured"
        ],
        "properties": {
          "timing_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "slice": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "activity_class": {
            "enum": [
              "implementation",
              "automated_test",
              "manual_e2e",
              "provider_wait",
              "user_wait",
              "interruption_recovery",
              "rework"
            ]
          },
          "wait_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "仅 *_wait 类必填：provider_latency/quota_limit/user_review/user_input/environment_provision/other:<说明>"
          },
          "started_at": {
            "type": "string",
            "description": "RFC 3339 UTC"
          },
          "ended_at": {
            "type": "string",
            "description": "RFC 3339 UTC"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "measured=true 时由 monotonic clock 测量，不得由 wall-clock 相减"
          },
          "measured": {
            "type": "boolean"
          },
          "retry": {
            "type": "integer"
          },
          "abort": {
            "type": "boolean"
          },
          "test_count": {
            "type": "integer"
          },
          "runtime_identity": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exec_exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "recorded_at": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "含 checkpoint（type=checkpoint：slice/note/at/head/dirty_patch_sha256）、phase（type=phase：action=start|end + phase + at，finalize 要求配对否则 PHASE_UNPAIRED）与 receipt_invalidated 等事件。1.3.0 起：真实 run 的活动跨度超 30 分钟而 timing 覆盖 <20% → TIMING_MISSING（error）；记账覆盖区间之间空洞超 120 分钟 → TIMING_GAP（error）——空洞可用申报模式 record-timing 补覆盖"
    },
    "applicability": {
      "type": "object",
      "description": "适用性判定（init 从 manifest 冻结）。三维必须全部显式声明，否则 APPLICABILITY_UNDECLARED；声明 true 则场景矩阵必须兑现对应条件，否则 APPLICABILITY_GATE_UNSATISFIED。",
      "properties": {
        "input_sensitive": {
          "type": "object",
          "required": [
            "value",
            "rationale",
            "decided_by"
          ],
          "properties": {
            "value": {
              "type": "boolean",
              "description": "该维度是否适用于本次交付"
            },
            "rationale": {
              "type": "string",
              "minLength": 10,
              "description": "判定依据。判 false（不适用）时尤其重要——它是事后追责的唯一抓手"
            },
            "decided_by": {
              "enum": [
                "agent",
                "user"
              ],
              "description": "谁做的判定。agent 自决合法，但会连同理由一并进 receipt digest 与报告"
            }
          }
        },
        "llm_payload_driven": {
          "type": "object",
          "required": [
            "value",
            "rationale",
            "decided_by"
          ],
          "properties": {
            "value": {
              "type": "boolean",
              "description": "该维度是否适用于本次交付"
            },
            "rationale": {
              "type": "string",
              "minLength": 10,
              "description": "判定依据。判 false（不适用）时尤其重要——它是事后追责的唯一抓手"
            },
            "decided_by": {
              "enum": [
                "agent",
                "user"
              ],
              "description": "谁做的判定。agent 自决合法，但会连同理由一并进 receipt digest 与报告"
            }
          }
        },
        "stateful_init": {
          "type": "object",
          "required": [
            "value",
            "rationale",
            "decided_by"
          ],
          "properties": {
            "value": {
              "type": "boolean",
              "description": "该维度是否适用于本次交付"
            },
            "rationale": {
              "type": "string",
              "minLength": 10,
              "description": "判定依据。判 false（不适用）时尤其重要——它是事后追责的唯一抓手"
            },
            "decided_by": {
              "enum": [
                "agent",
                "user"
              ],
              "description": "谁做的判定。agent 自决合法，但会连同理由一并进 receipt digest 与报告"
            }
          }
        }
      }
    },
    "executor_engine": {
      "type": [
        "string",
        "null"
      ],
      "description": "执行实现的引擎标识。与 auditor.engine 相同 → AUDITOR_INDEPENDENCE_UNVERIFIED（advisory 曝光自审自判）"
    },
    "integrity": {
      "type": "object",
      "description": "写入链（tamper-evident）。每次 CLI 写入追加一条 log；chain_n = sha256(chain_{n-1} + op + facts_digest_n)。validator 重算全链并核对末条 facts_digest 是否等于当前 fact 快照——不等即账本在 CLI 之外被改过。它防的是顺手改一行，不是有决心的伪造（伪造者可重算整链，但那是显式行为）。",
      "required": [
        "chain",
        "log"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "description": "当前链头（末条 log 的 chain）"
        },
        "log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seq",
              "op",
              "facts_digest",
              "chain"
            ],
            "properties": {
              "seq": {
                "type": "integer"
              },
              "op": {
                "type": "string"
              },
              "facts_digest": {
                "type": "string"
              },
              "chain": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "doc_only_globs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "项目自定义的 doc-only 白名单。**只能收窄**：最终判定 = 默认白名单 ∩ 本列表。不能用它把代码目录说成文档（manifest 由被测者自写，自报即生效的开关等于没有门）。"
    },
    "superseded_evidence": {
      "type": "array",
      "description": "被 `attach-evidence --replace` 顶替的旧证据条目（路径 + 旧 sha256 + 时间）。重测后证据文件会更新，没有合法更新路径时只能整轮重来；顶替动作进 integrity 链并在 report 显形，不是静默覆盖。",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "superseded_at": {
            "type": "string"
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "description": "历次 `re-attest` 记录：change_kind(doc-only|behavioral)、reason、changed_paths、runs_index。behavioral 之后 required 场景必须有更晚的 root PASS（RETEST_REQUIRED_AFTER_CHANGE）。",
      "items": {
        "type": "object",
        "required": [
          "change_kind",
          "recorded_at"
        ],
        "properties": {
          "change_kind": {
            "enum": [
              "doc-only",
              "behavioral"
            ]
          },
          "reason": {
            "type": "string"
          },
          "changed_count": {
            "type": "integer"
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runs_index": {
            "type": "integer"
          },
          "recorded_at": {
            "type": "string"
          },
          "content_digest": {
            "type": "string"
          },
          "exclusions": {
            "type": "array"
          },
          "exclusion_count": {
            "type": "integer"
          }
        }
      }
    },
    "challenge_loops": {
      "type": "array",
      "description": "Plan/review 循环原始事实。1.5 可显式选择 clustered 编排；legacy 与 1.4 modern 继续兼容。",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "not": {"required": ["contract_snapshots"]},
            "required": ["loop_id", "loop_type", "target_file", "baseline_hash", "rounds"],
            "properties": {
              "loop_id": {"type": "string"},
              "loop_type": {"type": "string"},
              "target_file": {"type": "string"},
              "baseline_hash": {"type": "string"},
              "started_at": {"type": "string"},
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["round", "plan_hash", "findings"],
                  "properties": {
                    "round": {"type": "integer", "minimum": 1},
                    "plan_hash": {"type": "string"},
                    "dedupe_key": {"type": "string"},
                    "findings": {
                      "type": "object",
                      "properties": {
                        "critical": {"type": "integer", "minimum": 0},
                        "major": {"type": "integer", "minimum": 0},
                        "minor": {"type": "integer", "minimum": 0}
                      }
                    },
                    "verdict": {"enum": ["PASS", "FAIL"]},
                    "timestamp": {"type": "string"}
                  }
                }
              },
              "status": {"type": "string"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loop_id", "loop_type", "target_file", "baseline_hash", "started_at",
              "limits", "acceptance_snapshots", "contract_snapshots", "rounds",
              "control_events", "status"
            ],
            "properties": {
              "loop_id": {"type": "string", "minLength": 1},
              "loop_type": {"type": "string", "minLength": 1},
              "target_file": {"type": "string", "minLength": 1},
              "baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "started_at": {"type": "string"},
              "orchestration": {"enum": ["legacy", "clustered"]},
              "primary_contradiction": {"type": "object"},
              "challenge_clusters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["cluster_id", "parent_finding_ids", "specialty", "question", "required_evidence", "specialist_required"],
                  "properties": {
                    "cluster_id": {"type": "string"},
                    "parent_finding_ids": {"type": "array", "items": {"type": "string"}},
                    "specialty": {"type": "string"},
                    "question": {"type": "string"},
                    "required_evidence": {"type": "array", "items": {"type": "string"}},
                    "specialist_required": {"type": "boolean"}
                  }
                }
              },
              "specialist_challenges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["cluster_id", "specialty", "status", "recorded_at"],
                  "properties": {
                    "cluster_id": {"type": "string"},
                    "specialty": {"type": "string"},
                    "status": {"enum": ["completed", "waived"]},
                    "output_path": {"type": "string"},
                    "output_sha256": {"type": "string"},
                    "waiver_reason": {"type": "string"},
                    "approval_hash": {"type": "string"},
                    "recorded_at": {"type": "string"}
                  }
                }
              },
              "synthesis": {
                "type": "object",
                "required": ["input_path", "input_sha256", "after_round", "recorded_at"]
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": ["soft", "user_review", "hard"],
                "properties": {
                  "soft": {"type": "integer", "minimum": 1},
                  "user_review": {"type": "integer", "minimum": 1},
                  "hard": {"type": "integer", "minimum": 1}
                }
              },
              "contract_snapshots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path", "sha256", "scope_hash", "threat_model_hash", "profile",
                    "acceptance_sha256",
                    "acceptance_ids", "assurance_ids", "recorded_at"
                  ],
                  "properties": {
                    "path": {"type": "string"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "threat_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "profile": {"enum": ["standard", "hardened", "hostile-host"]},
                    "acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "acceptance_ids": {"type": "array", "items": {"type": "string"}},
                    "assurance_ids": {"type": "array", "items": {"type": "string"}},
                    "recorded_at": {"type": "string"}
                  }
                }
              },
              "acceptance_snapshots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256", "recorded_at"],
                  "properties": {
                    "path": {"type": "string"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "recorded_at": {"type": "string"}
                  }
                }
              },
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "round", "review_mode", "coverage", "plan_hash", "based_on_plan_hash",
                    "scope_hash", "threat_model_hash", "findings", "new_critical_findings",
                    "reviewer_verdict", "timestamp"
                  ],
                  "properties": {
                    "round": {"type": "integer", "minimum": 1},
                    "review_mode": {"enum": ["breadth", "diff", "consolidated"]},
                    "coverage": {
                      "oneOf": [
                        {"type": "null"},
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "acceptance_coverage", "entry_and_trust_chain",
                            "data_flow_and_persistence", "identity_permissions_concurrency_cleanup",
                            "failure_and_recovery", "tests_and_evidence", "release_and_rollback",
                            "trusted_boundary_stop"
                          ],
                          "properties": {
                            "acceptance_coverage": {"const": true},
                            "entry_and_trust_chain": {"const": true},
                            "data_flow_and_persistence": {"const": true},
                            "identity_permissions_concurrency_cleanup": {"const": true},
                            "failure_and_recovery": {"const": true},
                            "tests_and_evidence": {"const": true},
                            "release_and_rollback": {"const": true},
                            "trusted_boundary_stop": {"const": true}
                          }
                        }
                      ]
                    },
                    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "based_on_plan_hash": {"type": ["string", "null"]},
                    "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "threat_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "findings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id", "severity", "scope_relation", "origin",
                          "violated_acceptance_ids", "assurance_contract_ids", "evidence",
                          "status", "root_cause"
                        ],
                        "properties": {
                          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
                          "severity": {"enum": ["P0", "P1", "P2"]},
                          "scope_relation": {"enum": ["in-scope", "out-of-scope", "scope-change-proposal"]},
                          "origin": {"enum": ["pre-existing", "patch-induced", "new-external-fact"]},
                          "violated_acceptance_ids": {"type": "array", "items": {"type": "string"}},
                          "assurance_contract_ids": {"type": "array", "items": {"type": "string"}},
                          "evidence": {"type": "string", "minLength": 1},
                          "status": {"enum": ["open", "resolved", "advisory"]},
                          "root_cause": {"type": "string", "minLength": 1},
                          "why_not_found_in_round_one": {"type": "string", "minLength": 1}
                        }
                      }
                    },
                    "new_critical_findings": {"type": "integer", "minimum": 0},
                    "reviewer_verdict": {"type": ["string", "null"], "enum": ["PASS", "FAIL", null]},
                    "timestamp": {"type": "string"}
                  }
                }
              },
              "control_events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action", "after_round", "outcome", "evidence", "approval_hash", "recorded_at"
                  ],
                  "properties": {
                    "action": {"enum": ["scope-audit", "architecture-reset", "user-review", "scope-change-approved"]},
                    "after_round": {"type": "integer", "minimum": 0},
                    "outcome": {"type": ["string", "null"]},
                    "evidence": {"type": "string", "minLength": 1},
                    "approval_hash": {"type": ["string", "null"]},
                    "plan_hash": {"type": "string"},
                    "acceptance_sha256": {"type": "string"},
                    "scope_hash": {"type": "string"},
                    "threat_model_hash": {"type": "string"},
                    "recorded_at": {"type": "string"}
                  }
                }
              },
              "status": {"type": "string"}
            }
          }
        ]
      }
    },
    "related_run_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "拆 slice 时声明的兄弟 run 目录；init 校验其形态（.../verification/<单层>）与存在性后冻结。"
    },
    "exclusion_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "init 时冻结的指纹排除范围（当前 run-dir + related_run_dirs）。事后往仓库塞任何文件都不改变它。"
    },
    "retired": {
      "type": "boolean",
      "description": "该 run 已被另一个通过的 run 取代而退役；仅影响 hook/CI 是否阻断，不改变账本的真实状态。"
    },
    "superseded_by": {
      "type": "string",
      "description": "继任 run 目录；retire 时校验其为非 fixture、SHIPPABLE 且 receipt 未失效。"
    },
    "retired_reason": {
      "type": "string"
    }
  },
  "$defs": {
    "auditFinding": {
      "type": "object",
      "required": ["id", "severity", "status", "type", "summary"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["P0", "P1", "P2"]},
        "status": {"enum": ["open", "resolved", "deferred"]},
        "type": {"type": "string"},
        "summary": {"type": "string"},
        "ac_ids": {"type": "array", "items": {"type": "string"}},
        "scenario_ids": {"type": "array", "items": {"type": "string"}},
        "required_retest": {"type": "boolean"},
        "imported_runs_index": {"type": "integer"},
        "resolution": {"type": "string"},
        "resolution_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "resolved_at": {"type": "string"},
        "resolved_candidate_content_digest": {"type": ["string", "null"]}
      }
    }
  }
}
